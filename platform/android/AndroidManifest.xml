<?xml version="1.0" encoding="utf-8"?>
<!-- Tawara for Android (docs/DECISIONS.md D32). NativeActivity: no
     classes.dex, so hasCode is false, and no Java, Kotlin or Gradle (D4).
     The native libraries are stored uncompressed and 16 KB-aligned, so the
     system maps them from the APK (extractNativeLibs false).

     Backups (docs/PLAN.md section 4.5): allowBackup is false, and the
     data-extraction rules exclude every domain from cloud backup and from
     device transfer, which Android 12 and later run whatever allowBackup
     says. The store lives in no_backup/ besides (D21), so it relies on no
     one guard alone.

     Back arrives as a key event (enableOnBackInvokedCallback false) and
     takes the task to the background; the activity is never finished. It
     itself handles each configuration change that configChanges names
     (D32 item 9 (i)), so Android does not recreate it for one. For any
     other change the activity is destroyed, which ends the process, and the
     next launch starts cold (D32 item 9 (d)). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.patricksmithlaravel.tawara">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Tawara"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- configChanges names the nineteen configuration changes this
             activity handles itself (docs/DECISIONS.md D32 item 9): the
             eighteen that API 35 defines, and assetsPaths, which API 36
             defines. Android destroys and recreates the activity for any
             change left out of the list, and a destroyed activity ends the
             application here: the fork's winit ends its event loop on
             Destroy, Tawara ends the process after it, and the next launch
             starts cold (D32 item 9 (d)). An asset-path change needs no
             action from the user. The navigation mode's overlay makes one,
             and so does the update the system applies to each application
             after an install, so an activity that does not declare
             assetsPaths is relaunched for it, and so ends. That is why the
             name is declared now and not when the target moves to 36.
             resourcesUnused is also from API 36, and waits for that move
             (D32 item 9 (i)). -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|fontWeightAdjustment|locale|layoutDirection|touchscreen|colorMode|mcc|mnc|grammaticalGender|assetsPaths">
            <meta-data android:name="android.app.lib_name" android:value="tawara_mobile" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
