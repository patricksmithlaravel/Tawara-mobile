<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tawara for iOS (docs/DECISIONS.md D32). The executable is crates/mobile's
     `tawara` binary; winit calls UIApplicationMain from it, so there is no
     storyboard and no Swift or Objective-C source. @PLATFORM@, @MINOS@ and
     @VERSION@ are filled in by platform/ios/tawara.sh. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Tawara</string>
	<key>CFBundleExecutable</key>
	<string>tawara</string>
	<key>CFBundleIdentifier</key>
	<string>com.patricksmithlaravel.tawara</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Tawara</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>@PLATFORM@</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>@MINOS@</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- The clock and icons of the status bar are light on Tawara's screens,
	     which are all dark (docs/DECISIONS.md D27 item 8). The iced fork's
	     winit view controller (vendor/winit/src/platform_impl/ios/view_controller.rs
	     at d4ab3a0) answers preferredStatusBarStyle with UIStatusBarStyleDefault,
	     which leaves the colour to UIKit: the clock was seen dark on the dark
	     background (iPhone 18 Pro simulator, iOS 27). With
	     UIViewControllerBasedStatusBarAppearance set to NO, UIKit takes the
	     style from UIStatusBarStyle below instead of asking the view controller,
	     so the fork does not change. -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Provisional wording, for the owner's approval (docs/DECISIONS.md D45
	     item 6): the reason the system shows when the wallet's unlock asks
	     for Face ID. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Tawara uses Face ID to unlock the wallet on this phone, when you have turned that on.</string>
	<!-- Provisional wording, for the owner's approval (docs/DECISIONS.md D42):
	     the reason the system shows when the scanner asks for the camera. The
	     key must be here: without it the system stops the application at the
	     request. No camera is required of the device, since the wallet runs
	     without one, so UIRequiredDeviceCapabilities names none. -->
	<key>NSCameraUsageDescription</key>
	<string>Tawara uses the camera to read a QR code with a destination address, when you choose to scan one.</string>
</dict>
</plist>
